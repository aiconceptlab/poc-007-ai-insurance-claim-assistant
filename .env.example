# The default is a labelled sample/manual mode. It makes no AI calls.
AI_MODE=demo
HOST=127.0.0.1
PORT=3010

# Set AI_MODE=openai to analyze photos, extract details and transcribe voice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Required for non-loopback hosting: use a random 32+ character shared token.
APP_ACCESS_TOKEN=
